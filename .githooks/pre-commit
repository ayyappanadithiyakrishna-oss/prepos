#!/bin/sh
# Gate: verified-SAT answer keys must pass before any commit that touches the
# problem bank or the verifier. Enforces master-prompt rule #3 automatically so
# a wrong answer key can never be committed. Enabled via `core.hooksPath`, set
# by the `prepare` npm script on install.

changed=$(git diff --cached --name-only)
case "$changed" in
  *lib/sat-practice/*|*scripts/verify_answers.py*)
    echo "› verifying SAT answer keys (rule #3)…"
    if ! python3 scripts/verify_answers.py; then
      echo "✗ commit blocked: SAT answer-key verification failed. Fix the keys or tags above."
      exit 1
    fi
    ;;
esac
case "$changed" in
  *lib/mastery-model.ts*|*lib/mastery-query.ts*|*scripts/test_mastery_model.ts*)
    echo "› testing mastery model (anti-fake gate)…"
    if ! node scripts/test_mastery_model.ts; then
      echo "✗ commit blocked: mastery-model tests failed."
      exit 1
    fi
    ;;
esac
exit 0
